# Build parameters for the CabinetOS image.
#
# Consumed by the Justfile, which is in turn called by .github/workflows/build.yml.

# Image name. Must match the GitHub repository name, because build-disk.yml
# derives the image to install from the repository name.
IMAGE_NAME=cabinetos

# GitHub username or organisation that owns the repository.
REPO_ORGANIZATION="MMagTech"

IMAGE_DESC="A console operating system for RomM libraries, built on Bazzite."
IMAGE_KEYWORDS="bootc,oci,linux,gaming,emulation,romm,console,cabinet"
IMAGE_LOGO_URL=""

# The floating tag published alongside the dated and SHA tags.
DEFAULT_TAG="latest"

# bootc-image-builder, used to turn the container image into a bootable disk.
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
