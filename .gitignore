# Cosign private signing key. If this is ever committed, rotate it immediately:
# anyone holding it can sign an image that your console will accept as an update.
cosign.key

# Disk image build output
output/
_build_*
_build-*/**
*_chunkah_*
*_rpm-ostree_*

# Build artefacts
previous.manifest.json
changelog.md
output.env

# Core builds. The source checkouts are clones of upstream at a pinned commit,
# reproducible from cores/build-core.sh, so they are cache and not history.
.core-src/
cores/build/
# A core's own system files, copied out of its source tree by the same script.
# PPSSPP is the only core that has any; see cores/build-core.sh.
cores/system/

# macOS
.DS_Store
