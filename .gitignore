# Cosign private signing key. If this is ever committed, rotate it immediately:
# anyone holding it can sign an image that your console will accept as an update.
cosign.key

# Disk image build output
output/
_build_*
_build-*/**
*_chunkah_*
*_rpm-ostree_*

# Build artefacts
previous.manifest.json
changelog.md
output.env

# Core builds. The source checkouts are clones of upstream at a pinned commit,
# reproducible from cores/build-core.sh, so they are cache and not history.
.core-src/
cores/build/
# A core's own system files, copied out of its source tree by the same script.
# PPSSPP is the only core that has any; see cores/build-core.sh.
cores/system/

# The frontend binary, built in a container on the test VM or in CI.
frontend/build/

# What the image build copies in that is not in this repository: the frontend
# binary, the twenty-one cores and PPSSPP's system files, collected by
# ci/stage-image-payload.sh.
#
# IGNORED RATHER THAN MERELY UNTRACKED, and that matters. The Justfile decides
# whether to stamp the image with a revision and a git-sha tag by asking
# whether `git status -s` is empty, so an untracked staging directory would
# quietly produce an unlabelled, untagged image.
image_payload/

# Where the image build downloads the frontend and core artifacts to before
# collecting them. Same reason as above: it must be ignored, not merely
# untracked, or `git status -s` stops being empty.
.artifacts/

# macOS
.DS_Store
.ui-loop.png
