#!/usr/bin/env bash
#
# Stops the frontend FIRST, and waits for it, before systemd stops anything
# else in the session. docs/PROJECT.md, open question 10b.
#
# WHY THIS EXISTS. On a shutdown systemd sends SIGTERM to every process in the
# unit at once — gamescope and the frontend together. The frontend, told to
# stop mid-game, leaves the way Exit to Home does and uploads the game's saves
# on the way out; that takes a second or two of network. With gamescope dying
# under it in the same instant, it could lose its window, and with it the
# process, before the upload finished. Pressing the power button during a game
# would then throw away whatever had been saved since the game started.
#
# So ExecStop runs this BEFORE the kill: the frontend alone gets SIGTERM, which
# SDL turns into an ordinary quit, and this waits until it has gone. When the
# frontend exits gamescope follows it, and systemd has nothing left to kill.
#
# IT MUST NOT HOLD A SHUTDOWN HOSTAGE. It waits a bounded time and then gives
# up quietly, and systemd's own stop timeout sits behind that.

set -uo pipefail

LIMIT="${CABINETOS_STOP_WAIT:-45}"
# The kernel keeps fifteen characters of a process name, so the installed
# binary and the development one (`cabinetos-frontend-dev`) are both this.
NAME="cabinetos-front"
ME="$(id -u)"

if ! pkill -TERM -u "${ME}" -x "${NAME}"; then
    exit 0   # nothing running: the session was already on its way down
fi
echo "cabinetos-session-stop: asked the frontend to stop; waiting up to ${LIMIT}s"

for ((i = 0; i < LIMIT * 10; i++)); do
    if ! pgrep -u "${ME}" -x "${NAME}" >/dev/null; then
        echo "cabinetos-session-stop: the frontend stopped after $((i / 10)).$((i % 10))s"
        exit 0
    fi
    sleep 0.1
done
echo "cabinetos-session-stop: the frontend did not stop within ${LIMIT}s; leaving it to systemd"
exit 0
