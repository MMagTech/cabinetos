// Let the console mount an extra INTERNAL drive, as it already may a USB one.
//
// udisks' stock policy lets the active session mount a removable drive
// (`filesystem-mount`, allow_active: yes), which is how a USB drive works
// with no rule of ours. An internal disk is `filesystem-mount-system`, whose
// default is a password prompt, and a console has nobody to answer one. An
// extra drive is an extra drive, internal or USB (MMagTech, 2026-09-25), so
// this grants that one action. docs/SETTINGS.md, Storage; issue #67.
//
// WHAT IS MOUNTED is decided by the frontend (frontend/src/drives.cpp): never
// the console's own drive, never Windows' EFI, reserved or recovery
// partitions, and only exFAT or NTFS. The console's own filesystems are
// mounted at boot already, so there is nothing of the system for this to
// reach.
//
// `subject.local`, as in 60-cabinetos-network.rules: the console on its own
// seat, not an SSH session.

polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.udisks2.filesystem-mount-system" &&
        subject.user == "cabinet" &&
        subject.local) {
        return polkit.Result.YES;
    }
});
