// Let the console mount an extra INTERNAL drive, as it already may a USB one,
// and format an internal drive, as it already may a USB one; and make its
// folder on an ext4 drive made elsewhere (cabinetos-drive-claim, #236).
//
// udisks' stock policy lets the active session mount and format a removable
// drive (`filesystem-mount`, `modify-device`: allow_active: yes), which is
// how a USB drive works with no rule of ours. An internal disk is
// `filesystem-mount-system` and `modify-device-system`, whose default is a
// password prompt, and a console has nobody to answer one. An extra drive is
// an extra drive, internal or USB (MMagTech, 2026-09-25), and a new SSD
// fitted inside the PC arrives blank and cannot be formatted anywhere else.
// docs/SETTINGS.md, Storage; issue #67.
//
// WHAT IS MOUNTED AND WHAT IS FORMATTED is decided by the frontend
// (frontend/src/drives.cpp): never the console's own drive; never Windows'
// EFI, reserved or recovery partitions; mounted only if exFAT, NTFS or ext4;
// formatted only if nothing of the console's is on it (no file under
// CabinetOS/) and nothing but the console has it mounted, checked again from
// udisks immediately before, and only after the PIN, a confirm naming the
// drive, its size and what is on it, and a code the console chose. udisks itself refuses to format anything mounted, so the
// console's own filesystems are out of reach twice over.
//
// `subject.local`, as in 60-cabinetos-network.rules: the console on its own
// seat, not an SSH session.

polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.udisks2.filesystem-mount-system" ||
         action.id == "org.freedesktop.udisks2.modify-device-system") &&
        subject.user == "cabinet" &&
        subject.local) {
        return polkit.Result.YES;
    }
});

// cabinetos-drive-claim takes no arguments and only ever makes an empty
// CabinetOS/ on an ext4 drive mounted for the console that has none.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "cabinetos-drive-claim.service" &&
        action.lookup("verb") == "start" &&
        subject.user == "cabinet" &&
        subject.local) {
        return polkit.Result.YES;
    }
});
