# Sinden's software for the one Sinden light gun whose serial port is %I (#575).
#
# Started by udev for each gun (73-cabinetos-sinden.rules), stopped when the
# gun's port goes: BindsTo= the port, so an unplugged gun, or one that drops
# off USB by itself, stops its copy, and the port coming back starts a fresh
# one. NO [Install]: nothing starts it but a gun.
#
# The launcher puts Sinden's software in a world holding only this gun
# (/usr/libexec/cabinetos-sinden; why: docs/decisions/2026-11-27-one-sinden-copy-per-gun.md).
#
# ITS OWN USER, made for each start: Sinden's software is a closed program and
# reads nothing of the player's. dialout and video are the groups of the gun's
# serial port and camera nodes; the devices it may open at all are only those
# two kinds.
#
# NO START LIMIT: a gun has dropped off USB sixteen times in ten seconds on
# the reference console as it settled (#575, the first day), each drop a new
# start, and a limit hit then would leave the gun dead once it settled.
#
# RESTARTED A SECOND AFTER IT STOPS: the launcher stops a copy that is not
# streaming from its camera, or whose camera has dropped off USB and come
# back, and the gun should aim again as soon as its camera is back. How
# often is the launcher's: it counts failed starts in the runtime folder,
# kept across these restarts (RuntimeDirectoryPreserve=restart), and waits
# before a start after two in a row, up to a minute. Not systemd's
# RestartSteps=: its count goes on through good runs until the unit is
# stopped (measured 2026-11-28), so a gun that dropped off USB a few times
# in an evening would wait a minute at every drop after.
#
# Sinden's software stops on SIGTERM (measured, 250 ms); the 5 s and the
# SIGKILL after them are for a copy that hangs.
#
# NOT ProtectKernelTunables= OR ProtectKernelLogs=: each covers a part of
# /proc, and then bwrap cannot mount the /proc of the gun's world ("Can't
# mount proc on /proc: Operation not permitted", tried 2026-11-27). The world
# has no way to write to the kernel's tunables or read its log anyway.
[Unit]
Description=CabinetOS: Sinden's software for the light gun on %I
Documentation=https://github.com/MMagTech/cabinetos/issues/575
BindsTo=dev-%i.device
After=dev-%i.device
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/libexec/cabinetos-sinden %I
SyslogIdentifier=cabinetos-sinden
Restart=always
RestartSec=1
# The launcher says why on exit 2: a port that is not a Sinden gun's.
RestartPreventExitStatus=2
TimeoutStopSec=5
DynamicUser=yes
SupplementaryGroups=dialout video
RuntimeDirectory=cabinetos-sinden/%i
RuntimeDirectoryPreserve=restart
DevicePolicy=closed
DeviceAllow=char-ttyACM rw
DeviceAllow=char-video4linux rw
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
