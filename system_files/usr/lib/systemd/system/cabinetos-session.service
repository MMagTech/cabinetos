[Unit]
Description=CabinetOS session

# Never stop trying. systemd's default is to give up after 5 starts in 10
# seconds, which on a console means a black screen that stays black — the exact
# failure the product cannot have. A machine that retries forever is recoverable;
# one that has given up is a support call.
StartLimitIntervalSec=0
Documentation=https://github.com/MMagTech/cabinetos
After=systemd-user-sessions.service systemd-logind.service
Wants=systemd-logind.service

# Takes tty1 instead of a login prompt. This is what makes the machine boot into
# CabinetOS rather than into a console — there is no getty to fall back to, and
# that is the point.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=cabinet

# Belt and braces under the tmpfiles.d entry that creates /var/lib/cabinetos.
# storage::root() falls back to the working directory when it cannot use
# /var/lib/cabinetos, and a service's working directory is `/` — so the one
# failure mode of that fallback is a console quietly filling the root of the
# filesystem with somebody's games. Landing in the session user's own home
# instead is wrong but visible and removable.
WorkingDirectory=/var/home/cabinet

# PAMName=login gives the process a real logind session on seat0, which
# gamescope needs to take the display and the input devices.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal

ExecStart=/usr/bin/cabinetos-session

# A console that has crashed back to a black screen is indistinguishable from a
# broken one. Always come back.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
