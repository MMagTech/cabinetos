#!/usr/bin/env bash
#
# The CabinetOS session.
#
# Launches gamescope with the CabinetOS frontend inside it. Until 2026-09-19
# this ran `sleep infinity` and a freshly installed machine booted to a black
# screen, because the image carried no frontend to run — see docs/PROJECT.md,
# Phase 5.
#
# This is deliberately not gamescope-session-plus. That harness is bazzite-deck
# only, and its substance is Steam bootstrapping and SteamOS management, which
# CabinetOS would be unpicking rather than using. See docs/PROJECT.md open
# question 3.

set -uo pipefail

# What the machine is, for the console to read.
#
# The image is the same on every machine; this file is not. It holds the things
# only this machine can know, and today that is one line:
#
#   CABINETOS_ROMM=192.168.1.10:6005
#
# The address is NOT baked into the image. This repository is public and
# somebody's LAN address does not belong in it, and an image with one server's
# address compiled in is useful to exactly one person. A console with no file
# here still boots — it comes up on the stand-in library and says on stderr
# that it has no server — which is the state the first-run screen will replace
# (docs/PROJECT.md, open question 15). It writes this same file.
#
# /etc, because that is the part of a bootc machine that is the machine's own
# and survives an update. Sourced rather than parsed: it is shell, and it is
# root-owned.
# `set -a` so everything the file defines is exported without this script
# having to know each name. It knows about CABINETOS_ROMM today and should not
# have to be edited to learn a second one.
if [[ -r /etc/cabinetos/session.env ]]; then
    set -a
    # shellcheck disable=SC1091  # machine-local, does not exist at build time
    source /etc/cabinetos/session.env
    set +a
fi

# The app to run inside gamescope.
#
# CABINETOS_APP overrides it, which is how a development machine points the
# session at a build it just compiled without touching the image. It is
# WORD-SPLIT deliberately, so it can carry arguments — which is also why a
# path with a space in it needs a wrapper script rather than quoting here.
APP="${CABINETOS_APP:-/usr/bin/cabinetos-frontend}"

if [[ ! -x /usr/bin/cabinetos-frontend && -z "${CABINETOS_APP:-}" ]]; then
    # Loudly, and then carry on into gamescope anyway: a session that refuses
    # to start is a machine that flaps on Restart=always, and the journal line
    # below is the one thing that tells whoever looks what is actually wrong.
    echo "cabinetos-session: ERROR — /usr/bin/cabinetos-frontend is not in this image"
fi

# ---------------------------------------------------------------------------
# The output resolution: the display's, not a number written here.
# ---------------------------------------------------------------------------
#
# THIS WAS HARDCODED TO 1920x1080 UNTIL 2026-09-19, and the first television it
# ever met was a 3840x2160 one. The console ran at 1080p and the panel scaled
# it up, which is the worst possible state for the work that comes next: the
# frontend's shapes are signed-distance fields and render exactly at any
# resolution — verified at 3840x2160, 1920x1080 and 1280x720 — so every soft
# edge on that screen was the television's scaler and none of it was the
# design. Judging the look against that is judging the wrong picture, the same
# mistake as tuning motion on llvmpipe.
#
# DROPPING THE FLAGS IS NOT THE FIX, AND THAT WAS MEASURED RATHER THAN
# ASSUMED. Run with no --output-width/--output-height at all and gamescope
# still chose 1920x1080@60Hz on a display offering 3840x2160. So the mode has
# to be found and passed.
#
# The kernel lists a connector's modes preferred-first, so the first line of
# `modes` on a connected connector is the display's own answer. A console
# should take it: docs/PROJECT.md says most sets are 4K and plenty are not,
# and that neither may be assumed.
#
# CABINETOS_OUTPUT=WxH overrides, for the machine plugged into something that
# lies about itself, and for testing a layout at a size nobody here owns.
detect_output() {
    local c status
    for c in /sys/class/drm/card*-*/; do
        status=$(cat "${c}/status" 2>/dev/null) || continue
        [[ "${status}" == "connected" ]] || continue
        # First line, first field: "3840x2160" from "3840x2160" or similar.
        local mode
        mode=$(head -1 "${c}/modes" 2>/dev/null | tr -d '[:space:]')
        [[ "${mode}" =~ ^[0-9]+x[0-9]+$ ]] || continue
        printf '%s' "${mode}"
        return 0
    done
    return 1
}

OUTPUT="${CABINETOS_OUTPUT:-$(detect_output || true)}"
if [[ "${OUTPUT}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    OUT_W="${BASH_REMATCH[1]}"
    OUT_H="${BASH_REMATCH[2]}"
    echo "cabinetos-session: output ${OUT_W}x${OUT_H} (from ${CABINETOS_OUTPUT:+CABINETOS_OUTPUT}${CABINETOS_OUTPUT:-the display})"
else
    # No connected connector yet — a television that is off, or an input not
    # selected. 1080p is a safe thing to ask any display for, and the session
    # restarts on its own if it dies, so the next attempt may find the panel.
    OUT_W=1920
    OUT_H=1080
    echo "cabinetos-session: no display reported a mode; asking for ${OUT_W}x${OUT_H}"
fi

# VARIABLE REFRESH WHEN THE TELEVISION HAS IT (#209, MMagTech 2026-10-01).
# `--adaptive-sync` turns VRR on only if the display reports it can, and does
# nothing otherwise; the emulators run with vsync off on their own limiters
# (standalone.cpp), so a VRR set shows each frame when it is ready. Only on
# drm: the other rungs have no display of their own to drive. The A9's LG C1
# reports no VRR on its current input settings (2026-10-01), so on it this
# changes nothing until the TV's game settings say otherwise.
run_gamescope() {
    local backend="$1"
    local vrr=()
    [[ "${backend}" == "drm" ]] && vrr=(--adaptive-sync)
    echo "cabinetos-session: starting gamescope (backend=${backend}${vrr:+, adaptive sync})"
    # shellcheck disable=SC2086  # APP is a command plus arguments
    exec gamescope \
        --backend "${backend}" \
        --output-width "${OUT_W}" \
        --output-height "${OUT_H}" \
        ${vrr[@]+"${vrr[@]}"} \
        -- ${APP}
}

# An explicit choice always wins.
if [[ -n "${CABINETOS_BACKEND:-}" ]]; then
    run_gamescope "${CABINETOS_BACKEND}"
fi

# Otherwise: work down a ladder of compositors, best first.
#
#   1. gamescope on drm  — production. VRR, HDR, scaling, the lot.
#   2. cage              — a minimal kiosk compositor, software rendered.
#                          Visible, but none of gamescope's display features.
#   3. gamescope headless — nothing on screen, but the session stays alive.
#
# Why the middle rung exists: gamescope requires a Vulkan device it accepts. A
# VM's virtual GPU typically offers OpenGL but not Vulkan — Mesa falls back to
# its software renderer and gamescope rejects it with "not a valid physical
# device". cage runs happily on software rendering, so a machine with no usable
# GPU still gets a real, visible session. That makes a GPU-less VM a usable
# development target for the frontend itself, not just for the plumbing.
#
# The frontend does not care which of these is hosting it — it is a Wayland
# client either way.
#
# Detection is by running the thing, not by inspecting /dev/dri. A device node
# existing does not mean a compositor can use it, and an earlier version that
# probed with a throwaway gamescope passed over SSH and still failed under the
# service, because what a compositor can do depends on the seat it starts from.

# Where logind puts this session's sockets. A compositor creates its Wayland
# socket here the moment it is serving, which is the backstop readiness signal
# for anything with no way to say so itself.
runtime_dir() { printf '%s' "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; }
# A glob and a socket test rather than `ls | grep`. The runtime directory holds
# `wayland-0.lock` and `gamescope-limiter-XXXXXX` beside the sockets, and
# asking whether a name IS a socket is a better question than asking whether it
# looks like one. Only a real socket means a compositor is serving.
#
# EACH SOCKET IS REPORTED WITH ITS INODE, AND THAT IS THE WHOLE POINT. The
# names repeat: cage always takes `wayland-0`, so a snapshot of NAMES taken
# before launching one is identical to the snapshot after it comes up, and a
# comparison of names detects nothing. Measured on the test VM, where cage
# reached the twenty-second timeout and was kept only because its process
# happened to still be alive — which is the same "is it still running" guess
# this whole function exists to replace.
#
# Binding a Unix socket unlinks any old file and creates a new one, so the
# INODE always changes even when the name does not. That is the fact that says
# "a compositor came up just now" rather than "a file with that name exists".
wayland_sockets() {
    local dir entry out=""
    dir=$(runtime_dir)
    for entry in "${dir}"/wayland-[0-9]* "${dir}"/gamescope-[0-9]*; do
        [[ -S "${entry}" ]] || continue
        out+="${entry##*/}:$(stat -c '%i' "${entry}" 2>/dev/null)"$'\n'
    done
    printf '%s' "${out}" | sort
}

# THE LADDER MUST TELL "THE COMPOSITOR FAILED" FROM "THE APP EXITED", and until
# 2026-09-19 it could not.
#
# The old test was "is the process still alive five seconds after launch", and
# it attributed the answer to the COMPOSITOR. But gamescope exits when its
# primary child exits, so a frontend that quit at one second — which is exactly
# what it does when the network is not up yet and RomM cannot be reached — was
# indistinguishable from a GPU that cannot do Vulkan. The ladder always blamed
# the compositor, and the console spent the rest of its session on llvmpipe
# while printing "no Vulkan-capable GPU" four seconds after gamescope had
# logged `selecting physical device 'AMD Radeon 890M Graphics (RADV STRIX1)'`
# and `selecting mode 3840x2160@60Hz`. Silently, with nothing on screen saying
# so, and recoverable only by somebody restarting the service by hand. Every
# power cut hit it. See docs/PROJECT.md, open question 22.
#
# SO ASK THE COMPOSITOR, RATHER THAN GUESSING FROM ITS CHILD. gamescope answers
# directly: `--ready-fd` is written to the instant the compositor is serving,
# which is the mechanism it provides for precisely this question. cage has no
# such flag and is judged by its Wayland socket appearing, which is the same
# fact observed from outside.
#
# Once a compositor has come up, a dead child is the APP's exit and never a
# reason to fall down the ladder: the session exits with the app's status and
# systemd starts it again at the top rung. That is a restart loop while the
# server is away, which is the honest behaviour and is bounded by the frontend
# waiting for the network itself — and it is a world away from being demoted to
# software rendering until somebody notices.
#
# Callers that can signal readiness put `--ready-fd 3` in their own arguments,
# before the `--`, because anything after that belongs to the app. Fd 3 is
# wired up here for every rung; it is harmless to one that does not use it.
try_compositor() {
    local label="$1"
    shift
    echo "cabinetos-session: trying ${label}"

    local before ready_file
    before=$(wayland_sockets)
    ready_file=$(mktemp "${TMPDIR:-/tmp}/cabinetos-ready.XXXXXX") || ready_file=/dev/null

    "$@" 3>"${ready_file}" &
    local pid=$!

    # Twenty seconds, in tenths. A compositor that has not served anything by
    # then is not about to, and the old five seconds was a guess that happened
    # to be longer than the frontend took to fail.
    local waited=0 ready=0
    while (( waited < 200 )); do
        if [[ -s "${ready_file}" ]] || [[ "$(wayland_sockets)" != "${before}" ]]; then
            ready=1
            break
        fi
        kill -0 "${pid}" 2>/dev/null || break
        sleep 0.1
        (( waited++ ))
    done

    if (( ready )); then
        echo "cabinetos-session: ${label} is up"
        rm -f "${ready_file}"
        wait "${pid}"
        local status=$?
        # Said out loud, because this is the line that stops the next person
        # reading a demotion into an ordinary exit.
        echo "cabinetos-session: ${label} exited with ${status} AFTER coming up —" \
             "that is the app's exit, not a display fault; not falling back"
        after_app "${status}"
    fi

    if kill -0 "${pid}" 2>/dev/null; then
        # Running, but it never said it was serving and made no socket. Keeping
        # the better rung is the safer bet: the failure this ladder exists for
        # is a compositor that cannot start at all, and this one has started.
        echo "cabinetos-session: ${label} never signalled ready but is running; keeping it"
        rm -f "${ready_file}"
        wait "${pid}"
        exit $?
    fi

    wait "${pid}" 2>/dev/null
    local status=$?
    rm -f "${ready_file}"
    echo "cabinetos-session: ${label} failed to start (status ${status})"
    return 1
}

# ---------------------------------------------------------------------------
# The Steam entry: hand the screen to Steam, then take it back (#223).
# ---------------------------------------------------------------------------
#
# Picking the Steam tile makes the frontend write `steam` into the request
# file and quit. gamescope ends with it; instead of exiting, the session runs
# Steam's own Big Picture session HERE, in this same login session on tty1,
# and when Steam closes it starts itself again from the top, so the console
# comes back on a fresh gamescope (about 0.8 s on the A9) and lands on the
# tile (the frontend reads the returned file).
#
# IN THIS SESSION, NOT AS A USER UNIT. Upstream's wrapper starts
# gamescope-session-plus@steam as a systemd user unit, which leaves gamescope
# outside any logind session, opening the display only through libseat's
# fallback to "the user's display session" (the audit's untested step). Run
# from here it is in the session that owns the seat, exactly as the console's
# own gamescope is. The wrapper's environment steps are copied below; the real
# script, /usr/share/gamescope-session-plus/gamescope-session-plus, runs as
# upstream ships it.
#
# NOTHING OF STEAM OUTLIVES IT. When the script returns, everything left in
# this session's cgroup except this shell is Steam's (steamwebhelper, a game,
# pressure-vessel's bwrap: Steam double-forks, so a process group would lose
# some), and is stopped: TERM, five seconds, KILL. Then the slice is detached,
# so not even Steam's files are reachable while the console runs.
#
# The request file is deleted BEFORE Steam starts, so a crash anywhere in
# here can never bring Steam back on its own: the next start is the console.
REQUEST_FILE="$(runtime_dir)/cabinetos-next"
RETURNED_FILE="$(runtime_dir)/cabinetos-from-steam"

# Read in this shell, not by grep: a grep would find itself in the list.
others_in() {
    local pid
    while read -r pid; do
        [[ "${pid}" == "$$" ]] && continue
        [[ "$(cat "/proc/${pid}/comm" 2>/dev/null)" == "(sd-pam)" ]] && continue
        return 0
    done < "$1"
    return 1
}

stop_leftovers() {
    local procs pid sig waited left
    procs="/sys/fs/cgroup$(cut -d: -f3 /proc/self/cgroup)/cgroup.procs"
    [[ -r "${procs}" ]] || { echo "cabinetos-session: cannot read ${procs}; not checking for leftovers"; return; }
    for sig in TERM KILL; do
        left=()
        while read -r pid; do
            [[ "${pid}" == "$$" ]] && continue
            # The login's own PAM helper is the console's, not Steam's: it is
            # what closes this session cleanly when the service ends. The first
            # handover on the A9 (2026-10-03) stopped it along with Steam.
            [[ "$(cat "/proc/${pid}/comm" 2>/dev/null)" == "(sd-pam)" ]] && continue
            left+=("${pid}")
        done < "${procs}"
        if (( ${#left[@]} == 0 )); then
            echo "cabinetos-session: nothing of Steam is left running"
            return
        fi
        # Named, because this line is the proof Steam was fully stopped, or
        # the record of what was not.
        echo "cabinetos-session: stopping ${#left[@]} left over (${sig}):" \
             "$(ps -o comm= -p "$(IFS=,; echo "${left[*]}")" 2>/dev/null | sort -u | tr '\n' ' ')"
        kill -s "${sig}" "${left[@]}" 2>/dev/null
        waited=0
        while (( waited < 50 )) && others_in "${procs}"; do
            sleep 0.1
            (( waited++ ))
        done
    done
}

steam_step() {
    echo "cabinetos-session: handing the screen to Steam"
    if ! systemctl --no-ask-password start cabinetos-steam@mount.service; then
        echo "cabinetos-session: Steam's slice could not be attached; back to the console"
        return
    fi

    # Steam starts only from its tile: an autostart entry it may have written
    # is never left for anything to find. And upstream's "five short sessions
    # in a row means Steam is broken" counter is cleared, since a person
    # opening Steam and closing it again is not a fault here.
    rm -f "${HOME}/.config/autostart/steam.desktop" \
          /tmp/chimeraos-short-session-tracker \
          /tmp/steamos-reboot-sentinel /tmp/steamos-shutdown-sentinel

    # Upstream's wrapper (/usr/bin/gamescope-session-plus), less the user unit.
    export XDG_SESSION_TYPE=x11
    # shellcheck disable=SC2046  # the names, one word each, as upstream does
    dbus-update-activation-environment --systemd DESKTOP_SESSION \
        $(env | grep ^XDG_ | cut -d = -f 1) 2>/dev/null
    systemctl --user set-environment XDG_DESKTOP_PORTAL_DIR="" 2>/dev/null
    systemctl --user unset-environment DISPLAY XAUTHORITY 2>/dev/null

    # The display's own size, as the console uses, and VRR when the TV has it
    # (#209); upstream turns these into gamescope's -W/-H and --adaptive-sync.
    #
    # WITHOUT THE LOGIN'S CAPABILITIES. The console's login session carries
    # CAP_WAKE_ALARM in its ambient set (CapAmb 0x800000000; an SSH login
    # has none), and Steam's sandbox, bubblewrap, refuses to run with any
    # capability it is not setuid for ("Unexpected capabilities but not
    # setuid"), which Steam reports as "Steam now requires user namespaces
    # to be enabled" in a window gamescope never shows: a black screen. Found
    # on the A9's first handover, 2026-10-03; reproduced and fixed there with
    # exactly this. gamescope keeps its own cap_sys_nice from its file.
    SCREEN_WIDTH="${OUT_W}" SCREEN_HEIGHT="${OUT_H}" ADAPTIVE_SYNC=1 \
    SRT_LOG_TO_JOURNAL=1 \
        setpriv --inh-caps=-all --ambient-caps=-all -- \
        /usr/share/gamescope-session-plus/gamescope-session-plus steam
    echo "cabinetos-session: Steam's session ended (status $?)"

    systemctl --user unset-environment XDG_DESKTOP_PORTAL_DIR 2>/dev/null
    stop_leftovers

    if ! systemctl --no-ask-password start cabinetos-steam@unmount.service; then
        echo "cabinetos-session: Steam's slice could not be detached"
    fi
    : > "${RETURNED_FILE}"
}

# Called when the app has exited after its compositor came up. A request to
# hand over to Steam is acted on and the session starts again from the top;
# anything else exits as before, and systemd restarts the session.
after_app() {
    local status="$1" request=""
    [[ -r "${REQUEST_FILE}" ]] && request=$(<"${REQUEST_FILE}")
    rm -f "${REQUEST_FILE}"
    if [[ "${request}" == steam && -x /usr/share/gamescope-session-plus/gamescope-session-plus ]]; then
        steam_step
        echo "cabinetos-session: back to the console"
        exec "$0"
    fi
    exit "${status}"
}

# A request left by a session that died before acting on it is not acted on.
rm -f "${REQUEST_FILE}"

if ls /dev/dri/card* >/dev/null 2>&1; then
    # --ready-fd goes BEFORE the `--`: everything after it is the app's.
    # shellcheck disable=SC2086
    # --adaptive-sync: VRR when the television reports it (#209), as in
    # run_gamescope. THIS is the line a console normally starts on; the first
    # version put the flag only in run_gamescope, which runs when a backend is
    # forced, and the testing image of 2026-10-02 started without it.
    try_compositor "gamescope (drm)" \
        gamescope --backend drm --output-width "${OUT_W}" --output-height "${OUT_H}" \
                  --adaptive-sync --ready-fd 3 -- ${APP}

    # Degraded, and loudly so. A console that works without VRR beats a black
    # screen, but this should never be the state on real hardware — if it is,
    # something is wrong with the GPU or its driver, and the About screen should
    # say which compositor is running so it is visible rather than mysterious.
    #
    # REACHING THIS LINE NOW MEANS SOMETHING. Until 2026-09-19 it was also
    # printed when the frontend had merely exited, which made it a lie on a
    # machine with a perfectly good Radeon in it.
    echo "cabinetos-session: WARNING — no Vulkan-capable GPU. Falling back to cage."
    echo "cabinetos-session: display features (VRR, HDR, scaling) are unavailable."
    # shellcheck disable=SC2086
    WLR_RENDERER=pixman try_compositor "cage (software rendering)" \
        cage -d -- ${APP}
else
    echo "cabinetos-session: no drm device present"
fi

# Last resort: no display at all. Nothing is drawn, but the session stays up so
# the machine is reachable and the service does not flap.
run_gamescope headless
