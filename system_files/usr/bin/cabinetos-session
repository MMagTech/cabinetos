#!/usr/bin/env bash
#
# The CabinetOS session.
#
# Launches gamescope with the CabinetOS frontend inside it. Until 2026-09-19
# this ran `sleep infinity` and a freshly installed machine booted to a black
# screen, because the image carried no frontend to run — see docs/PROJECT.md,
# Phase 5.
#
# This is deliberately not gamescope-session-plus. That harness is bazzite-deck
# only, and its substance is Steam bootstrapping and SteamOS management, which
# CabinetOS would be unpicking rather than using. See docs/PROJECT.md open
# question 3.

set -uo pipefail

# What the machine is, for the console to read.
#
# The image is the same on every machine; this file is not. It holds the things
# only this machine can know, and today that is one line:
#
#   CABINETOS_ROMM=192.168.1.10:6005
#
# The address is NOT baked into the image. This repository is public and
# somebody's LAN address does not belong in it, and an image with one server's
# address compiled in is useful to exactly one person. A console with no file
# here still boots — it comes up on the stand-in library and says on stderr
# that it has no server — which is the state the first-run screen will replace
# (docs/PROJECT.md, open question 15). It writes this same file.
#
# /etc, because that is the part of a bootc machine that is the machine's own
# and survives an update. Sourced rather than parsed: it is shell, and it is
# root-owned.
# `set -a` so everything the file defines is exported without this script
# having to know each name. It knows about CABINETOS_ROMM today and should not
# have to be edited to learn a second one.
if [[ -r /etc/cabinetos/session.env ]]; then
    set -a
    # shellcheck disable=SC1091  # machine-local, does not exist at build time
    source /etc/cabinetos/session.env
    set +a
fi

# The app to run inside gamescope.
#
# CABINETOS_APP overrides it, which is how a development machine points the
# session at a build it just compiled without touching the image. It is
# WORD-SPLIT deliberately, so it can carry arguments — which is also why a
# path with a space in it needs a wrapper script rather than quoting here.
APP="${CABINETOS_APP:-/usr/bin/cabinetos-frontend}"

if [[ ! -x /usr/bin/cabinetos-frontend && -z "${CABINETOS_APP:-}" ]]; then
    # Loudly, and then carry on into gamescope anyway: a session that refuses
    # to start is a machine that flaps on Restart=always, and the journal line
    # below is the one thing that tells whoever looks what is actually wrong.
    echo "cabinetos-session: ERROR — /usr/bin/cabinetos-frontend is not in this image"
fi

# ---------------------------------------------------------------------------
# The output resolution: the display's, not a number written here.
# ---------------------------------------------------------------------------
#
# THIS WAS HARDCODED TO 1920x1080 UNTIL 2026-09-19, and the first television it
# ever met was a 3840x2160 one. The console ran at 1080p and the panel scaled
# it up, which is the worst possible state for the work that comes next: the
# frontend's shapes are signed-distance fields and render exactly at any
# resolution — verified at 3840x2160, 1920x1080 and 1280x720 — so every soft
# edge on that screen was the television's scaler and none of it was the
# design. Judging the look against that is judging the wrong picture, the same
# mistake as tuning motion on llvmpipe.
#
# DROPPING THE FLAGS IS NOT THE FIX, AND THAT WAS MEASURED RATHER THAN
# ASSUMED. Run with no --output-width/--output-height at all and gamescope
# still chose 1920x1080@60Hz on a display offering 3840x2160. So the mode has
# to be found and passed.
#
# The kernel lists a connector's modes preferred-first, so the first line of
# `modes` on a connected connector is the display's own answer. A console
# should take it: docs/PROJECT.md says most sets are 4K and plenty are not,
# and that neither may be assumed.
#
# CABINETOS_OUTPUT=WxH overrides, for the machine plugged into something that
# lies about itself, and for testing a layout at a size nobody here owns.
detect_output() {
    local c status
    for c in /sys/class/drm/card*-*/; do
        status=$(cat "${c}/status" 2>/dev/null) || continue
        [[ "${status}" == "connected" ]] || continue
        # First line, first field: "3840x2160" from "3840x2160" or similar.
        local mode
        mode=$(head -1 "${c}/modes" 2>/dev/null | tr -d '[:space:]')
        [[ "${mode}" =~ ^[0-9]+x[0-9]+$ ]] || continue
        printf '%s' "${mode}"
        return 0
    done
    return 1
}

OUTPUT="${CABINETOS_OUTPUT:-$(detect_output || true)}"
if [[ "${OUTPUT}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    OUT_W="${BASH_REMATCH[1]}"
    OUT_H="${BASH_REMATCH[2]}"
    echo "cabinetos-session: output ${OUT_W}x${OUT_H} (from ${CABINETOS_OUTPUT:+CABINETOS_OUTPUT}${CABINETOS_OUTPUT:-the display})"
else
    # No connected connector yet — a television that is off, or an input not
    # selected. 1080p is a safe thing to ask any display for, and the session
    # restarts on its own if it dies, so the next attempt may find the panel.
    OUT_W=1920
    OUT_H=1080
    echo "cabinetos-session: no display reported a mode; asking for ${OUT_W}x${OUT_H}"
fi

run_gamescope() {
    local backend="$1"
    echo "cabinetos-session: starting gamescope (backend=${backend})"
    # shellcheck disable=SC2086  # APP is a command plus arguments
    exec gamescope \
        --backend "${backend}" \
        --output-width "${OUT_W}" \
        --output-height "${OUT_H}" \
        -- ${APP}
}

# An explicit choice always wins.
if [[ -n "${CABINETOS_BACKEND:-}" ]]; then
    run_gamescope "${CABINETOS_BACKEND}"
fi

# Otherwise: work down a ladder of compositors, best first.
#
#   1. gamescope on drm  — production. VRR, HDR, scaling, the lot.
#   2. cage              — a minimal kiosk compositor, software rendered.
#                          Visible, but none of gamescope's display features.
#   3. gamescope headless — nothing on screen, but the session stays alive.
#
# Why the middle rung exists: gamescope requires a Vulkan device it accepts. A
# VM's virtual GPU typically offers OpenGL but not Vulkan — Mesa falls back to
# its software renderer and gamescope rejects it with "not a valid physical
# device". cage runs happily on software rendering, so a machine with no usable
# GPU still gets a real, visible session. That makes a GPU-less VM a usable
# development target for the frontend itself, not just for the plumbing.
#
# The frontend does not care which of these is hosting it — it is a Wayland
# client either way.
#
# Detection is by running the thing, not by inspecting /dev/dri. A device node
# existing does not mean a compositor can use it, and an earlier version that
# probed with a throwaway gamescope passed over SSH and still failed under the
# service, because what a compositor can do depends on the seat it starts from.

try_compositor() {
    local label="$1"
    shift
    echo "cabinetos-session: trying ${label}"
    "$@" &
    local pid=$!
    sleep 5
    if kill -0 "${pid}" 2>/dev/null; then
        echo "cabinetos-session: ${label} is up"
        wait "${pid}"
        exit $?
    fi
    echo "cabinetos-session: ${label} died on startup"
    return 1
}

if ls /dev/dri/card* >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    try_compositor "gamescope (drm)" \
        gamescope --backend drm --output-width "${OUT_W}" --output-height "${OUT_H}" -- ${APP}

    # Degraded, and loudly so. A console that works without VRR beats a black
    # screen, but this should never be the state on real hardware — if it is,
    # something is wrong with the GPU or its driver, and the About screen should
    # say which compositor is running so it is visible rather than mysterious.
    echo "cabinetos-session: WARNING — no Vulkan-capable GPU. Falling back to cage."
    echo "cabinetos-session: display features (VRR, HDR, scaling) are unavailable."
    # shellcheck disable=SC2086
    WLR_RENDERER=pixman try_compositor "cage (software rendering)" \
        cage -d -- ${APP}
else
    echo "cabinetos-session: no drm device present"
fi

# Last resort: no display at all. Nothing is drawn, but the session stays up so
# the machine is reachable and the service does not flap.
run_gamescope headless
